TZ=Asia/Shanghai

# 唯一需要你填的地方：DeepSeek API Key
DEEPSEEK_API_KEY=

# AstrBot 后台登录密码（用户名 astrbot）
ASTRBOT_DASHBOARD_PASSWORD=please-change-me

# NapCat WebUI 登录口令
NAPCAT_WEBUI_TOKEN=please-change-me

# 端口：改这里要同步改 local/AstrBot/data/cmd_config.json 和 NapCat 的 onebot11.json
ASTRBOT_PORT=6185
NAPCAT_WEBUI_PORT=6099
ASTRBOT_WS_PORT=6199
