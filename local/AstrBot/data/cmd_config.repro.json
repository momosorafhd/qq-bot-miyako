{
  "config_version": 5,
  "platform_settings": {
    "unique_session": false,
    "rate_limit": {
      "time": 60,
      "count": 120,
      "strategy": "discard"
    },
    "reply_prefix": "",
    "forward_threshold": 1500,
    "enable_id_white_list": true,
    "id_whitelist": [],
    "id_whitelist_log": true,
    "wl_ignore_admin_on_group": true,
    "wl_ignore_admin_on_friend": true,
    "reply_with_mention": false,
    "reply_with_quote": false,
    "path_mapping": [],
    "segmented_reply": {
      "enable": false,
      "only_llm_result": true,
      "interval_method": "random",
      "interval": "1.5,3.5",
      "log_base": 2.6,
      "words_count_threshold": 150,
      "split_mode": "regex",
      "regex": ".*?[。？！~…]+|.+$",
      "split_words": [
        "。",
        "？",
        "！",
        "~",
        "…"
      ],
      "content_cleanup_rule": ""
    },
    "no_permission_reply": true,
    "empty_mention_waiting": true,
    "empty_mention_waiting_need_reply": true,
    "friend_message_needs_wake_prefix": false,
    "ignore_bot_self_message": false,
    "ignore_at_all": false
  },
  "provider_sources": [
    {
      "id": "deepseek-flash_source",
      "provider": "deepseek",
      "type": "openai_chat_completion",
      "provider_type": "chat_completion",
      "key": [
        "$DEEPSEEK_API_KEY"
      ],
      "api_base": "https://api.deepseek.com/v1",
      "timeout": 120,
      "proxy": "",
      "custom_headers": {}
    },
    {
      "id": "zhipu_vision_source",
      "provider": "zhipu",
      "type": "openai_chat_completion",
      "provider_type": "chat_completion",
      "key": [
        "$ZHIPU_API_KEY"
      ],
      "api_base": "https://open.bigmodel.cn/api/paas/v4",
      "timeout": 60,
      "proxy": "",
      "custom_headers": {}
    },
    {
      "id": "gsv_source",
      "provider": "gpt_sovits",
      "type": "miyako_gsv_tts",
      "provider_type": "text_to_speech",
      "api_base": "http://127.0.0.1:9880",
      "gpt_weights_path": "__PROJECT_ROOT__\\voice\\weights\\11g-miyako-e40.ckpt",
      "sovits_weights_path": "__PROJECT_ROOT__\\voice\\weights\\11g-miyako_e40_s3480.pth",
      "timeout": 90,
      "gsv_default_parms": {
        "gsv_text_lang": "ja",
        "gsv_prompt_lang": "ja",
        "gsv_ref_audio_path": "__PROJECT_ROOT__\\voice\\ref\\miyako_ref.wav",
        "gsv_prompt_text": "そうね。新海くんもお疲れ様。　いつもありがとう",
        "gsv_media_type": "wav",
        "gsv_streaming_mode": "false",
        "gsv_top_k": "15",
        "gsv_top_p": "1",
        "gsv_temperature": "1",
        "gsv_speed_factor": "1.0"
      }
    }
  ],
  "provider": [
    {
      "id": "deepseek-flash",
      "enable": true,
      "model": "deepseek-flash",
      "custom_extra_body": {
        "thinking": {
          "type": "disabled"
        }
      },
      "provider_source_id": "deepseek-flash_source",
      "modalities": []
    },
    {
      "id": "zhipu-vision",
      "enable": true,
      "model": "glm-4v-flash",
      "provider_source_id": "zhipu_vision_source",
      "modalities": [
        "image"
      ]
    },
    {
      "id": "gsv-miyako",
      "enable": true,
      "provider_source_id": "gsv_source"
    }
  ],
  "provider_settings": {
    "enable": true,
    "default_image_caption_provider_id": "",
    "image_caption_prompt": "用一句中文描述这张图，供群聊聊天使用。必须用中文，不要英文。1) 表情包：画面+情绪，并把图上的文字原样抄下来，例如「柴犬歪头，字：啊？」。2) 人物：写清发色发型、瞳色、服装、动作表情。3) 如果特征和下面某位明显吻合，写出名字（同人图画风有差异，只写能对上的，对不上就只描述特征，不要猜）：九条都=棕色及腰长发、刘海垂在两眼之间、蓝眼睛、头上别着发饰；希亚=黑色及肩发、红瞳、身材很小、黑色洛丽塔裙配黑连裤袜；天=白色长发、紫瞳、左侧马尾且鬓角有小辫子、常穿橙色露脐连帽衫；春风=浅紫色双马尾长发、青色眼睛、白色制服配深蓝波点发带和彩色花瓣发夹。不超过45字，不要以「这张图片」开头。",
    "provider_pool": [
      "*"
    ],
    "wake_prefix": "",
    "web_search": true,
    "websearch_provider": "deepseek",
    "websearch_tavily_key": [],
    "websearch_bocha_key": [],
    "websearch_brave_key": [],
    "websearch_baidu_app_builder_key": "",
    "websearch_firecrawl_key": [],
    "websearch_exa_key": [],
    "websearch_anysearch_key": [],
    "websearch_deepseek_key": [],
    "websearch_serpapi_key": [],
    "web_search_link": false,
    "display_reasoning_text": false,
    "identifier": true,
    "group_name_display": true,
    "datetime_system_prompt": true,
    "persona_pool": [
      "*"
    ],
    "prompt_prefix": "{{prompt}}",
    "streaming_response": false,
    "show_tool_use_status": false,
    "show_tool_call_result": false,
    "buffer_intermediate_messages": false,
    "max_quoted_fallback_images": 20,
